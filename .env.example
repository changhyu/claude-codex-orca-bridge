# Public HTTPS origin routed (e.g. via Cloudflare Tunnel) to local callback port 127.0.0.1:8766
BRIDGE_CALLBACK_ORIGIN=https://bridge.example.com

# Target local git repository root used to scope workspace MCP & Orca discovery
BRIDGE_PROJECT_DIR=/path/to/your/project

# Optional canonical Orca repository key for paired remote host discovery (e.g. github.com/your-org/your-repo)
BRIDGE_ORCA_REPOSITORY=

# Optional Git roster sync settings (used by src/sync_cloud_roster.py)
BRIDGE_ROSTER_GIT_URL=
BRIDGE_ROSTER_BRANCH=refs/heads/main
BRIDGE_ROSTER_PATH=docs/AGENT_ROSTER.md
BRIDGE_ROSTER_SECTION=## Agents

# Optional regex enforcing git origin remote on src/create_claude_cloud.py
BRIDGE_GIT_REMOTE_REGEX=

# Peer aliases & Remote MCP path
BRIDGE_CLAUDE_PEER_ALIAS=claude-peer
BRIDGE_CLAUDE_MCP_PATH=/mcp/claude
BRIDGE_CODEX_ADMIN_ALIAS=codex-bridge-admin
BRIDGE_CODEX_ADMIN_THREAD=00000000-0000-0000-0000-000000000000
BRIDGE_CODEX_CLOUD_ALIAS=codex-cloud-peer
BRIDGE_CODEX_CLOUD_THREAD=00000000-0000-0000-0000-000000000000
# Comma-separated allowed cloud environment IDs. Empty disables cloud discovery.
BRIDGE_CODEX_ENVIRONMENTS=

# Optional CLI binary overrides (auto-detected via PATH / ~/.local/bin by default)
BRIDGE_CLAUDE_BIN=
BRIDGE_ORCA_BIN=
BRIDGE_CODEX_BIN=
BRIDGE_GIT_BIN=

# Optional macOS launchd service prefix for watchdog auto-restart
BRIDGE_LAUNCHD_PREFIX=io.agentbridge
